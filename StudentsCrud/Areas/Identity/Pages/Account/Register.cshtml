@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .auth-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .auth-card {
        width: 100%;
        max-width: 420px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        padding: 2.5rem 2rem;
    }

    .auth-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6a5af9, #a685fa);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem auto;
        color: #fff;
        font-size: 1.6rem;
    }

    .auth-title {
        text-align: center;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .auth-subtitle {
        text-align: center;
        color: #6c757d;
        margin-bottom: 1.75rem;
        font-size: 0.95rem;
    }

    .auth-card .form-floating {
        margin-bottom: 1rem;
    }

    .auth-card .btn-primary {
        background: linear-gradient(135deg, #6a5af9, #a685fa);
        border: none;
        border-radius: 10px;
        padding: 0.75rem;
        font-weight: 600;
    }

        .auth-card .btn-primary:hover {
            opacity: 0.92;
        }

    .auth-links {
        text-align: center;
        margin-top: 1.25rem;
        font-size: 0.9rem;
    }

        .auth-links a {
            color: #6a5af9;
            text-decoration: none;
        }

            .auth-links a:hover {
                text-decoration: underline;
            }

    .auth-divider {
        display: flex;
        align-items: center;
        text-align: center;
        color: #adb5bd;
        margin: 1.5rem 0;
        font-size: 0.85rem;
    }

        .auth-divider::before,
        .auth-divider::after {
            content: "";
            flex: 1;
            border-bottom: 1px solid #e9ecef;
        }

        .auth-divider:not(:empty)::before {
            margin-right: .75em;
        }

        .auth-divider:not(:empty)::after {
            margin-left: .75em;
        }
</style>

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-icon">
            <i class="bi bi-person-plus-fill"></i>
        </div>
        <h1 class="auth-title h3">Create account</h1>
        <p class="auth-subtitle">Sign up to get started</p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Register</button>

            <div class="auth-links">
                Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
            </div>
        </form>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="auth-divider">or continue with</div>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div class="d-grid gap-2">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                            @provider.DisplayName
                        </button>
                    }
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
