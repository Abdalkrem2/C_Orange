@model IEnumerable<MVCTask2.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>

                <td>
                    @if (!string.IsNullOrEmpty(category.ImagePath))
                    {
                        <img src="@category.ImagePath"
                             width="100"
                             height="100"
                             style="object-fit: cover;" />
                    }
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@category.Id">
                        Edit
                    </a> |

                    <a asp-action="Details"
                       asp-route-id="@category.Id">
                        Details
                    </a> |

                    <a asp-action="Delete"
                       asp-route-id="@category.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>