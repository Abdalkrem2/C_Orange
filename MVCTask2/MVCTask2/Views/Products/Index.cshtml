@model IEnumerable<MVCTask2.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                Name
            </th>

            <th>
                Price
            </th>

            <th>
                Image
            </th>

            <th>
                Category
            </th>

            <th>
                Actions
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Name
                </td>

                <td>
                    @item.Price
                </td>

                <td>
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath"
                             width="100"
                             height="100"
                             style="object-fit: cover;" />
                    }
                </td>

                <td>
                    @item.Category?.Name
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id">
                        Edit
                    </a> |

                    <a asp-action="Details"
                       asp-route-id="@item.Id">
                        Details
                    </a> |

                    <a asp-action="Delete"
                       asp-route-id="@item.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>